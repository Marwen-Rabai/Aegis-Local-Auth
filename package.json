{
  "name": "aegis-local-auth",
  "version": "2.0.0",
  "description": "Enterprise SMS Verification Platform - Professional self-sovereign authentication with unlimited registration and real-time analytics",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js --watch",
    "dev:debug": "nodemon --inspect server.js",
    "setup": "node setup.js",
    "install-deps": "node install.js",
    "test": "npm run test:health && npm run test:api",
    "test:health": "node test/health-check.js",
    "test:api": "node test/api-tests.js",
    "test:load": "node test/load-test.js",
    "check": "node check-installation.js",
    "verify": "node check-installation.js",
    "build": "npm ci --only=production",
    "build:docker": "docker build -t aegis-local-auth .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "migrate": "node scripts/migrate.js",
    "logs": "tail -f logs/aegis.log",
    "health": "curl -f http://localhost:3000/api/health",
    "prod": "NODE_ENV=production node server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "precommit": "npm run lint && npm run test",
    "postinstall": "node scripts/post-install.js",
    "setup-adb": "node setup-adb.js",
    "test:adb": "node test-adb-system.js",
    "cleanup": "node scripts/cleanup-logs.js",
    "clean:logs": "node scripts/cleanup-logs.js"
  },
  "keywords": [
    "authentication",
    "sms",
    "gsm",
    "modem",
    "local",
    "self-sovereign",
    "otp",
    "mass-registration"
  ],
  "author": "MARWEN RABAI <marwenrabai@gmail.com> (https://marwenrabai.strtikingly.com)",
  "license": "MIT",
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@serialport/parser-readline": "^11.0.0",
    "bcrypt": "^5.1.1",
    "chart.js": "^4.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "framer-motion": "^12.23.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "prom-client": "^15.0.0",
    "rate-limiter-flexible": "^3.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-error-boundary": "^6.0.0",
    "serialport": "^12.0.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "artillery": "^2.0.0",
    "axios": "^1.10.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.2",
    "nodemon": "^2.0.7",
    "pm2": "^6.0.8",
    "prettier": "^3.6.2",
    "supertest": "^6.3.3",
    "unzipper": "^0.10.14"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
